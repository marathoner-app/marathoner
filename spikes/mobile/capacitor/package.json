{
  "name": "marathoner-capacitor-spike",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^22.0.0"
  },
  "scripts": {
    "build:web": "npm --prefix ../../.. run build:mobile-spike",
    "build:auth": "npm --prefix ../../.. run build:mobile-auth-spike",
    "build:shared-record": "npm --prefix ../../.. run build:mobile-shared-record-spike",
    "sync:ios": "cap sync ios",
    "open:ios": "cap open ios",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.auth.json",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "typescript": "~6.0.3"
  }
}
