# Explicit environment and public API key for the selected beta iOS build.
# Copy this file to .env.ios-beta.local and provide the reviewed beta-only key.
# The public Loops interest-list configuration is loaded from .env.ios-beta.
# Never commit the populated local file.
VITE_FIREBASE_ENVIRONMENT=beta
VITE_FIREBASE_IOS_API_KEY=
VITE_CLOSED_BETA_PROVISIONAL_METHODOLOGY=true
