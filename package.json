{
  "name": "marathoner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://github.com/marathoner-app/marathoner",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:server-boundary && npm run check:creator-radar-infrastructure && tsc -b && vite build",
    "build:mobile-spike": "npm run check:server-boundary && npm run check:creator-radar-infrastructure && tsc -b && vite build --mode mobile-spike --outDir spikes/mobile/capacitor/web --emptyOutDir",
    "check:server-boundary": "node scripts/check-server-boundary.mjs",
    "check:creator-radar-infrastructure": "node scripts/check-creator-radar-infrastructure.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:firestore": "firebase emulators:exec --project demo-marathoner --only firestore \"vitest run --config vitest.firestore.config.ts\"",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@amcharts/amcharts4": "^4.10.40",
    "@amcharts/amcharts5": "^5.11.1",
    "firebase": "^11.10.0",
    "framer-motion": "^12.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/firebase": "^2.4.32",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "firebase-tools": "^15.25.1",
    "globals": "^15.14.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
