# Copy to .env.marathoner-d9bf9 only after issue #347 approves the owner-only
# development Functions path. Keep false until the guarded smoke-test window.
MARATHONER_COMPLETED_RUN_COMMANDS_ENABLED=false
# Allows the exact pinned provisional plan only for the closed development
# dogfood build. The beta project never installs this policy.
MARATHONER_PROVISIONAL_PLAN_DOGFOOD_ENABLED=false
# Enables the trusted pending draft-adaptation command only for the paired
# development dogfood UI. Keep false outside an explicitly approved proof.
MARATHONER_INTERNAL_ADAPTATION_RECOMMENDATIONS_ENABLED=false
# Live Garmin grants are prohibited in development. OAuth behavior is exercised
# with synthetic provider fixtures in unit and emulator tests.
GARMIN_OAUTH_ENABLED=false
GARMIN_OAUTH_ENVIRONMENT=development
GARMIN_ACTIVITY_PUSH_ENABLED=false
GARMIN_ACTIVITY_PUSH_SOURCE_CIDRS=
