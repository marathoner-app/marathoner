{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "..",
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "../src/domain/materialCommands/**/*.ts",
    "../src/domain/methodology/closedBetaProvisionalMethodology.ts",
    "../src/domain/methodology/closedBetaMethodologyConsent.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.integration.ts",
    "../src/domain/materialCommands/**/*.test.ts"
  ]
}
