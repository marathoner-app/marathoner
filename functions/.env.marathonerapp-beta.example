# Copy to .env.marathonerapp-beta only for the reviewed #205/#347 deployment.
# Keep the copied file ignored and set this non-secret activation value to true
# only for the explicit completed-run command rehearsal.
MARATHONER_COMPLETED_RUN_COMMANDS_ENABLED=false
# Keep disabled until the private Garmin app exists, its exact callback is
# registered, and the owner explicitly approves the live connection rehearsal.
GARMIN_OAUTH_ENABLED=false
GARMIN_OAUTH_ENVIRONMENT=beta
GARMIN_CLIENT_ID=
GARMIN_OAUTH_REDIRECT_URI=
GARMIN_AUTHORIZATION_URL=
GARMIN_TOKEN_URL=
GARMIN_REVOCATION_URL=
# GARMIN_CLIENT_SECRET is a Secret Manager value, never an env-file value.
