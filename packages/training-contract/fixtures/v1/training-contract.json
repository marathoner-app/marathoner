    },
    {
      "id": "identifier.completed-run.valid",
      "schemaVersion": 1,
      "subject": "completedRunId",
      "expected": { "valid": true },
      "value": "run-fixture-1"
    },
    {
      "id": "identifier.completed-run.path",
      "schemaVersion": 1,
      "subject": "completedRunId",
