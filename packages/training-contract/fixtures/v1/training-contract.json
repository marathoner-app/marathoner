    {
      "id": "identifier.user.padded",
      "schemaVersion": 1,
      "subject": "userId",
      "expected": { "valid": false, "reason": "Identifiers cannot contain surrounding whitespace." },
      "value": " runner-fixture-1 "
    },
    {
      "id": "identifier.plan.valid",
      "schemaVersion": 1,
      "subject": "trainingPlanId",
      "expected": { "valid": true },
