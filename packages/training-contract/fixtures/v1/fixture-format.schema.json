{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marathonerapp.com/schemas/training-contract-fixtures-v1.json",
  "title": "Marathoner training contract fixture set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "fixtureFormatVersion",
    "contractVersion",
    "fixtures"
  ],
  "properties": {
    "$schema": {
      "const": "./fixture-format.schema.json"
    },
    "fixtureFormatVersion": {
      "const": 1
    },
    "contractVersion": {
      "const": "training-domain@1"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "schemaVersion",
          "subject",
          "expected",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "schemaVersion": {
            "const": 1
          },
          "subject": {
            "enum": [
              "userId",
              "trainingPlanId",
              "plannedWorkoutId",
              "completedRunId",
              "shoeId",
              "distanceMeters",
              "durationSeconds",
              "dateOnly",
              "utcDateTime",
              "ianaTimeZone",
              "userProfile",
              "trainingPlan",
              "plannedWorkout",
              "completedRun",
              "shoe"
            ]
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "valid"
            ],
            "properties": {
              "valid": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "value": true
        }
      }
    }
  }
}
