rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidOwnedWrite(userId) {
      return request.resource.data.schemaVersion == 1
        && request.resource.data.userId == userId;
    }

    function isSharedRecordProof(proofId) {
      return proofId == 'issue-87-shared-record';
    }

    function isValidSharedRecordProof(userId) {
      return request.resource.data.keys().hasAll([
          'schemaVersion',
          'recordType',
          'userId',
          'sampleRunId',
          'distanceMeters',
          'sourceClient'
        ])
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'recordType',
          'userId',
          'sampleRunId',
          'distanceMeters',
          'sourceClient'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.recordType == 'shared_training_record_proof'
        && request.resource.data.userId == userId
        && request.resource.data.sampleRunId == 'issue-87-sample-run'
        && request.resource.data.distanceMeters == 5000
        && request.resource.data.sourceClient in ['web', 'capacitor', 'expo'];
    }

    match /users/{userId}/plans/{planId} {
      allow read, delete: if isSignedInAs(userId);
      allow create, update: if isSignedInAs(userId)
        && isValidOwnedWrite(userId);

      match /workouts/{workoutId} {
        allow read, delete: if isSignedInAs(userId);
        allow create, update: if isSignedInAs(userId)
          && isValidOwnedWrite(userId)
          && request.resource.data.planId == planId;
      }
    }

    match /users/{userId}/runs/{runId} {
      allow read, delete: if isSignedInAs(userId);
      allow create, update: if isSignedInAs(userId)
        && isValidOwnedWrite(userId);
    }

    match /users/{userId}/shoes/{shoeId} {
      allow read, delete: if isSignedInAs(userId);
      allow create, update: if isSignedInAs(userId)
        && isValidOwnedWrite(userId);
    }

    match /users/{userId}/mobileSpikeProofs/{proofId} {
      allow read, delete: if isSharedRecordProof(proofId)
        && isSignedInAs(userId);
      allow create, update: if isSharedRecordProof(proofId)
        && isSignedInAs(userId)
        && isValidSharedRecordProof(userId);
    }
  }
}
