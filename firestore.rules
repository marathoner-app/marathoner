rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidOwnedWrite(userId) {
      return request.resource.data.schemaVersion == 1
        && request.resource.data.userId == userId;
    }

    match /users/{userId}/plans/{planId} {
      allow read, delete: if isSignedInAs(userId);
      allow create, update: if isSignedInAs(userId)
        && isValidOwnedWrite(userId);

      match /workouts/{workoutId} {
        allow read, delete: if isSignedInAs(userId);
        allow create, update: if isSignedInAs(userId)
          && isValidOwnedWrite(userId)
          && request.resource.data.planId == planId;
      }
    }

    match /users/{userId}/runs/{runId} {
      allow read, delete: if isSignedInAs(userId);
      allow create, update: if isSignedInAs(userId)
        && isValidOwnedWrite(userId);
    }

    match /users/{userId}/shoes/{shoeId} {
      allow read, delete: if isSignedInAs(userId);
      allow create, update: if isSignedInAs(userId)
        && isValidOwnedWrite(userId);
    }
  }
}
