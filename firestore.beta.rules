rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasVerifiedEmail() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function hasApprovedBetaMembership(userId) {
      return exists(
          /databases/$(database)/documents/betaMemberships/$(userId)
        )
        && get(
          /databases/$(database)/documents/betaMemberships/$(userId)
        ).data.keys().hasAll([
          'schemaVersion',
          'userId',
          'status',
          'approvedAt',
          'approvedBy'
        ])
        && get(
          /databases/$(database)/documents/betaMemberships/$(userId)
        ).data.keys().hasOnly([
          'schemaVersion',
          'userId',
          'status',
          'approvedAt',
          'approvedBy'
        ])
        && get(
          /databases/$(database)/documents/betaMemberships/$(userId)
        ).data.schemaVersion == 1
        && get(
          /databases/$(database)/documents/betaMemberships/$(userId)
        ).data.userId == userId
        && get(
          /databases/$(database)/documents/betaMemberships/$(userId)
        ).data.status == 'approved'
        && get(
          /databases/$(database)/documents/betaMemberships/$(userId)
        ).data.approvedAt is timestamp
        && get(
          /databases/$(database)/documents/betaMemberships/$(userId)
        ).data.approvedBy is string
        && get(
          /databases/$(database)/documents/betaMemberships/$(userId)
        ).data.approvedBy.size() > 0
        && get(
          /databases/$(database)/documents/betaMemberships/$(userId)
        ).data.approvedBy.size() <= 128;
    }

    function canAccessBetaTrainingData(userId) {
      return isSignedInAs(userId)
        && hasVerifiedEmail()
        && hasApprovedBetaMembership(userId);
    }

    function isValidOwnedWrite(userId) {
      return request.resource.data.schemaVersion == 1
        && request.resource.data.userId == userId;
    }

    function isDateOnlyString(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isNonblankBoundedString(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength
        && value.matches('^[\\s\\S]*\\S[\\s\\S]*$');
    }

    function isBoundedIdentifier(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 128
        && value.matches('^[^/\\s]([^/]*[^/\\s])?$');
    }

    function hasValidAvailableTrainingDays(data) {
      return !data.keys().hasAny(['availableTrainingDays'])
        || (data.availableTrainingDays is list
          && data.availableTrainingDays.size() <= 7
          && data.availableTrainingDays.hasOnly([
            'monday',
            'tuesday',
            'wednesday',
            'thursday',
            'friday',
            'saturday',
            'sunday'
          ])
          && data.availableTrainingDays.toSet().size()
            == data.availableTrainingDays.size());
    }

    function hasValidOptionalProfileFields(data) {
      return (!data.keys().hasAny(['displayName'])
          || isNonblankBoundedString(data.displayName, 120))
        && (!data.keys().hasAny(['experienceLevel'])
          || data.experienceLevel in [
            'not_running',
            'inconsistent',
            'returning',
            'consistent'
          ])
        && (!data.keys().hasAny(['consistentRunningWeeks'])
          || (data.consistentRunningWeeks is int
            && data.consistentRunningWeeks >= 0))
        && (!data.keys().hasAny(['currentWeeklyDistanceMeters'])
          || (data.currentWeeklyDistanceMeters is int
            && data.currentWeeklyDistanceMeters >= 0))
        && (!data.keys().hasAny(['currentRunningFrequencyDaysPerWeek'])
          || (data.currentRunningFrequencyDaysPerWeek is int
            && data.currentRunningFrequencyDaysPerWeek >= 0
            && data.currentRunningFrequencyDaysPerWeek <= 7))
        && (!data.keys().hasAny(['longestRecentRunDistanceMeters'])
          || (data.longestRecentRunDistanceMeters is int
            && data.longestRecentRunDistanceMeters >= 0))
        && hasValidAvailableTrainingDays(data)
        && (!data.keys().hasAny(['preferredLongRunDay'])
          || data.preferredLongRunDay in [
            'monday',
            'tuesday',
            'wednesday',
            'thursday',
            'friday',
            'saturday',
            'sunday'
          ])
        && (!data.keys().hasAny(['scheduleConstraints'])
          || isNonblankBoundedString(data.scheduleConstraints, 500))
        && (!data.keys().hasAny(['completionGoal'])
          || data.completionGoal == 'complete_first_marathon');
    }

    function hasValidTargetRace(data) {
      return !data.keys().hasAny(['targetRace'])
        || (data.targetRace is map
          && ((data.targetRace.keys().hasOnly(['kind', 'date'])
              && data.targetRace.kind == 'date'
              && isDateOnlyString(data.targetRace.date))
            || (data.targetRace.keys().hasOnly([
                  'kind',
                  'startDate',
                  'endDate'
                ])
              && data.targetRace.kind == 'window'
              && isDateOnlyString(data.targetRace.startDate)
              && isDateOnlyString(data.targetRace.endDate)
              && data.targetRace.endDate >= data.targetRace.startDate)));
    }

    function hasValidRecentPerformance(data) {
      return !data.keys().hasAny(['recentPerformance'])
        || (data.recentPerformance is map
          && data.recentPerformance.keys().hasOnly([
            'completedOn',
            'distanceMeters',
            'durationSeconds'
          ])
          && isDateOnlyString(data.recentPerformance.completedOn)
          && data.recentPerformance.distanceMeters is int
          && data.recentPerformance.distanceMeters > 0
          && data.recentPerformance.durationSeconds is int
          && data.recentPerformance.durationSeconds > 0);
    }

    function isValidProfileWrite(userId) {
      let data = request.resource.data;
      return isValidOwnedWrite(userId)
        && data.keys().hasAll([
          'schemaVersion',
          'userId',
          'preferredDistanceUnit',
          'timeZone',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'userId',
          'displayName',
          'preferredDistanceUnit',
          'timeZone',
          'experienceLevel',
          'consistentRunningWeeks',
          'targetRace',
          'currentWeeklyDistanceMeters',
          'currentRunningFrequencyDaysPerWeek',
          'longestRecentRunDistanceMeters',
          'recentPerformance',
          'availableTrainingDays',
          'preferredLongRunDay',
          'scheduleConstraints',
          'completionGoal',
          'createdAt',
          'updatedAt'
        ])
        && data.preferredDistanceUnit in ['mile', 'kilometer']
        && data.timeZone is string
        && data.timeZone.size() > 0
        && data.timeZone.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt >= data.createdAt
        && hasValidOptionalProfileFields(data)
        && hasValidTargetRace(data)
        && hasValidRecentPerformance(data)
        && (!data.keys().hasAny(['preferredLongRunDay'])
          || !data.keys().hasAny(['availableTrainingDays'])
          || data.availableTrainingDays.hasAny([
            data.preferredLongRunDay
          ]));
    }

    function isValidProfileCreate(userId) {
      return isValidProfileWrite(userId)
        && request.resource.data.createdAt == request.resource.data.updatedAt;
    }

    function isValidProfileUpdate(userId) {
      let next = request.resource.data;
      let prior = resource.data;
      return isValidProfileWrite(userId)
        && next.schemaVersion == prior.schemaVersion
        && next.userId == prior.userId
        && next.createdAt == prior.createdAt
        && next.updatedAt >= prior.updatedAt;
    }

    function hasValidWorkoutTargets(data) {
      let hasDistance = data.keys().hasAny(['targetDistanceMeters']);
      let hasDuration = data.keys().hasAny(['targetDurationSeconds']);
      return (hasDistance || hasDuration)
        && (!hasDistance
          || (data.targetDistanceMeters is int
            && data.targetDistanceMeters > 0))
        && (!hasDuration
          || (data.targetDurationSeconds is int
            && data.targetDurationSeconds > 0));
    }

    function hasValidWorkoutKindFields(data) {
      return (data.kind == 'rest'
          && data.keys().hasOnly([
            'schemaVersion',
            'userId',
            'planId',
            'scheduledDate',
            'phase',
            'status',
            'kind',
            'notes',
            'createdAt',
            'updatedAt'
          ]))
        || (data.kind == 'run'
          && data.keys().hasAll(['purpose'])
          && data.keys().hasOnly([
            'schemaVersion',
            'userId',
            'planId',
            'scheduledDate',
            'phase',
            'status',
            'kind',
            'notes',
            'purpose',
            'targetDistanceMeters',
            'targetDurationSeconds',
            'createdAt',
            'updatedAt'
          ])
          && data.purpose in [
            'easy',
            'recovery',
            'long',
            'tempo',
            'intervals',
            'race'
          ]
          && hasValidWorkoutTargets(data))
        || (data.kind == 'walk_run'
          && data.keys().hasOnly([
            'schemaVersion',
            'userId',
            'planId',
            'scheduledDate',
            'phase',
            'status',
            'kind',
            'notes',
            'targetDistanceMeters',
            'targetDurationSeconds',
            'createdAt',
            'updatedAt'
          ])
          && hasValidWorkoutTargets(data));
    }

    function isValidWorkoutWrite(userId, planId) {
      let data = request.resource.data;
      return isValidOwnedWrite(userId)
        && data.planId == planId
        && data.keys().hasAll([
          'schemaVersion',
          'userId',
          'planId',
          'scheduledDate',
          'phase',
          'status',
          'kind',
          'createdAt',
          'updatedAt'
        ])
        && isDateOnlyString(data.scheduledDate)
        && data.phase in [
          'learn_to_run',
          'base_building',
          'marathon_training',
          'race_preparation',
          'recovery'
        ]
        && data.status in ['planned', 'completed', 'skipped']
        && (!data.keys().hasAny(['notes'])
          || isNonblankBoundedString(data.notes, 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt >= data.createdAt
        && hasValidWorkoutKindFields(data);
    }

    function isValidWorkoutUpdate(userId, planId) {
      let next = request.resource.data;
      let prior = resource.data;
      return isValidWorkoutWrite(userId, planId)
        && next.diff(prior).affectedKeys().hasOnly(['status', 'updatedAt'])
        && next.schemaVersion == prior.schemaVersion
        && next.userId == prior.userId
        && next.planId == prior.planId
        && next.kind == prior.kind
        && next.createdAt == prior.createdAt
        && next.updatedAt > prior.updatedAt
        && ((prior.status == 'planned' && next.status == 'completed')
          || (prior.status == 'completed' && next.status == 'planned'));
    }

    function hasValidRunAssociations(data) {
      let hasPlanId = data.keys().hasAny(['plannedWorkoutPlanId']);
      let hasWorkoutId = data.keys().hasAny(['plannedWorkoutId']);
      return hasPlanId == hasWorkoutId
        && (!hasPlanId
          || (isBoundedIdentifier(data.plannedWorkoutPlanId)
            && isBoundedIdentifier(data.plannedWorkoutId)))
        && (!data.keys().hasAny(['shoeId'])
          || isBoundedIdentifier(data.shoeId));
    }

    function hasValidOptionalRunFeedback(data) {
      return (!data.keys().hasAny(['perceivedEffort'])
          || data.perceivedEffort in [
            'much_easier_than_expected',
            'easier_than_expected',
            'about_right',
            'harder_than_expected',
            'much_harder_than_expected'
          ])
        && (!data.keys().hasAny(['unusualPain'])
          || data.unusualPain is bool)
        && (!data.keys().hasAny(['notes'])
          || isNonblankBoundedString(data.notes, 500));
    }

    function isValidRunWrite(userId) {
      let data = request.resource.data;
      return isValidOwnedWrite(userId)
        && data.keys().hasAll([
          'schemaVersion',
          'userId',
          'startedAt',
          'timeZone',
          'distanceMeters',
          'durationSeconds',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'userId',
          'plannedWorkoutPlanId',
          'plannedWorkoutId',
          'shoeId',
          'startedAt',
          'timeZone',
          'distanceMeters',
          'durationSeconds',
          'perceivedEffort',
          'unusualPain',
          'notes',
          'createdAt',
          'updatedAt'
        ])
        && data.startedAt is timestamp
        && isNonblankBoundedString(data.timeZone, 64)
        && data.distanceMeters is int
        && data.distanceMeters > 0
        && data.durationSeconds is int
        && data.durationSeconds > 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt >= data.createdAt
        && hasValidRunAssociations(data)
        && hasValidOptionalRunFeedback(data);
    }

    function isValidRunCreate(userId) {
      return isValidRunWrite(userId)
        && request.resource.data.createdAt == request.resource.data.updatedAt;
    }

    function isValidRunUpdate(userId) {
      let next = request.resource.data;
      let prior = resource.data;
      return isValidRunWrite(userId)
        && next.schemaVersion == prior.schemaVersion
        && next.userId == prior.userId
        && next.createdAt == prior.createdAt
        && next.updatedAt >= prior.updatedAt;
    }

    function isValidShoeWrite(userId) {
      let data = request.resource.data;
      return isValidOwnedWrite(userId)
        && data.keys().hasAll([
          'schemaVersion',
          'userId',
          'name',
          'startingDistanceMeters',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'userId',
          'name',
          'startingDistanceMeters',
          'status',
          'retiredOn',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.startingDistanceMeters is int
        && data.startingDistanceMeters >= 0
        && data.status in ['active', 'retired']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt >= data.createdAt
        && ((data.status == 'active'
              && !data.keys().hasAny(['retiredOn']))
          || (data.status == 'retired'
              && isDateOnlyString(data.retiredOn)));
    }

    function isValidShoeCreate(userId) {
      return isValidShoeWrite(userId)
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.resource.data.updatedAt;
    }

    function isValidShoeUpdate(userId) {
      let next = request.resource.data;
      let prior = resource.data;
      return isValidShoeWrite(userId)
        && next.schemaVersion == prior.schemaVersion
        && next.userId == prior.userId
        && next.startingDistanceMeters == prior.startingDistanceMeters
        && next.createdAt == prior.createdAt
        && next.updatedAt >= prior.updatedAt
        && (prior.status == 'active'
          || (prior.status == 'retired'
            && next.status == 'retired'
            && next.retiredOn == prior.retiredOn));
    }

    match /betaMemberships/{userId} {
      allow get: if isSignedInAs(userId) && hasVerifiedEmail();
      allow list, create, update, delete: if false;
    }

    match /accountDeletionRequests/{requestId} {
      allow read, write: if false;
    }

    match /materialCommandReceipts/{userId}/commands/{commandId} {
      allow read, write: if false;
    }

    match /operatorControls/{controlId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow get: if canAccessBetaTrainingData(userId);
      allow create: if canAccessBetaTrainingData(userId)
        && isValidProfileCreate(userId);
      allow update: if canAccessBetaTrainingData(userId)
        && isValidProfileUpdate(userId);
      allow list, delete: if false;
    }

    match /users/{userId}/plans/{planId} {
      allow read: if canAccessBetaTrainingData(userId);
      allow create, update, delete: if false;

      match /workouts/{workoutId} {
        allow read: if canAccessBetaTrainingData(userId);
        allow create, delete: if false;
        allow update: if canAccessBetaTrainingData(userId)
          && isValidWorkoutUpdate(userId, planId);
      }

      match /metadata/{metadataId} {
        allow read: if canAccessBetaTrainingData(userId);
        allow write: if false;
      }
    }

    match /users/{userId}/planState/{stateId} {
      allow read: if canAccessBetaTrainingData(userId);
      allow write: if false;
    }

    match /users/{userId}/planRevisionSnapshots/{snapshotId} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /users/{userId}/recommendationEvidence/{recommendationId} {
      allow read: if canAccessBetaTrainingData(userId);
      allow write: if false;
    }

    match /users/{userId}/runs/{runId} {
      allow read, delete: if canAccessBetaTrainingData(userId);
      allow create: if canAccessBetaTrainingData(userId)
        && isValidRunCreate(userId);
      allow update: if canAccessBetaTrainingData(userId)
        && isValidRunUpdate(userId);
    }

    match /users/{userId}/shoes/{shoeId} {
      allow read: if canAccessBetaTrainingData(userId);
      allow create: if canAccessBetaTrainingData(userId)
        && isValidShoeCreate(userId);
      allow update: if canAccessBetaTrainingData(userId)
        && isValidShoeUpdate(userId);
      allow delete: if false;
    }
  }
}
